  <Object type="0xF91F" id="Eye of the Ominous"><Class>Equipment</Class><Item/><Texture><File>OminousBelowItems</File><Index>0</Index></Texture><SlotType>12</SlotType><ST/><Description>The abyss does not smite in anger—it simply passes judgment.&#10;&#10;75 MP. Deals 500 base area damage, increased by 5% per Wisdom.&#10;+5 Dexterity. +5 Wisdom. +10 Critical Chance. +10 Loot Chance.</Description><Soulbound/><Usable/><BagType>10</BagType><MpCost>75</MpCost><ActivateOnEquip stat="28" amount="5">IncrementStat</ActivateOnEquip><ActivateOnEquip stat="27" amount="5">IncrementStat</ActivateOnEquip><ActivateOnEquip stat="114" amount="10">IncrementStat</ActivateOnEquip><ActivateOnEquip stat="102" amount="10">IncrementStat</ActivateOnEquip><Activate radius="4.5" totalDamage="500" color="0xffa64dff">OminousSealBlast</Activate><Activate effect="Healing" duration="3.5" range="4.5" color="0xff0080" target="player" center="player" visualEffect="5" useWisMod="true">GenericActivate</Activate><Activate effect="Damaging" duration="3.5" range="4.5" color="0xff0080" target="player" center="player" visualEffect="0" useWisMod="true">GenericActivate</Activate><feedPower>1000</feedPower><DisplayId>Eye of the Ominous</DisplayId></Object>
